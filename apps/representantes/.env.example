# =====================================================
# Plataforma do Representante · Grupo Catarina
# representantes.grupocatarina.com
# Copie para .env e ajuste os valores antes do primeiro deploy.
# =====================================================

# --- App ---
NODE_ENV=production
PORT=8080
# URL pública (usada em links de e-mail e cookies seguros)
APP_URL=https://representantes.grupocatarina.com

# --- Auth ---
# Gere uma chave longa: openssl rand -base64 48
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
# Duração da sessão (ex: 12h, 7d)
JWT_TTL=12h
# Cookie seguro (true em produção com HTTPS; false em dev http)
COOKIE_SECURE=true

# --- Banco (SQLite) ---
# Caminho do arquivo do banco (dentro do container use um volume)
DB_PATH=./db/gc.sqlite

# --- Uploads (fotos do PDV) ---
UPLOAD_DIR=./public/uploads
UPLOAD_MAX_MB=5

# --- Integração Excia (ERP) ---
# A API do Excia só responde na LAN da empresa (192.168.1.6:211).
# Quando o servidor NÃO alcança a LAN (ex: VPS Hostinger), deixe
# EXCIA_MODE=file para a plataforma ler do último export processado.
# Quando rodar dentro da rede, use EXCIA_MODE=live.
EXCIA_MODE=file
EXCIA_BASE=http://192.168.1.6:211
EXCIA_TOKEN=troque-pelo-token-do-excia
# Arquivo de coleção (status/rank de produtos) atualizado pela carga
EXCIA_COLECAO_FILE=./data/colecao_data.json

# --- Administração ---
# Administradora do site (recebe cópia das notificações; login cod 0 / 0000).
ADMIN_EMAIL=thatiane.marques@grupocatarina.com
ADMIN_NOME=Thatiane Marques

# --- Notificações (aprovações) · SMTP SkyMail (grupocatarina.com) ---
# Valores confirmados pelo TI (Anderson, 15/07/2026). Se SMTP_HOST ficar
# vazio, as notificações são apenas logadas no console.
# 587 = STARTTLS (o mailer usa secure=false); 465 = SSL/TLS (secure=true).
SMTP_HOST=sender.skymail.net.br
SMTP_PORT=587
SMTP_USER=contato@grupocatarina.com
# NÃO commitar a senha — preencher só no .env do VPS:
SMTP_PASS=
# Remetente deve ser a MESMA conta autenticada (alinhamento SPF/DKIM):
SMTP_FROM=contato@grupocatarina.com

# --- Logs ---
LOG_LEVEL=info
