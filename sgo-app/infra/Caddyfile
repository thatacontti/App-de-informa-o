# ADAPTADO para o VPS grupocatarina-vps: o portal serve em HTTP interno
# (porta 80 do container). O HTTPS e o dominio budget.grupocatarina.com
# sao tratados pelo Nginx Proxy Manager, que encaminha para sgo-portal:80.
:80 {
	encode gzip

	# Gestor do banco de dados (Adminer), protegido pela senha do portal
	handle_path /adminer* {
		basic_auth {
			admin {$SENHA_PORTAL_HASH}
		}
		reverse_proxy adminer:8080
	}

	# FASE 6 DO ROTEIRO: quando o backend existir, descomente
	# handle /api/* {
	# 	reverse_proxy api:3000
	# }

	# Portal (o sistema)
	handle {
		basic_auth {
			admin {$SENHA_PORTAL_HASH}
		}
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
