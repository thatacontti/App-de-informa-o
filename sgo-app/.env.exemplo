# Copie este arquivo para .env e preencha. NUNCA suba o .env para repositório público.

# Endereço público do portal (publicado pelo Nginx Proxy Manager)
DOMINIO=budget.grupocatarina.com

# Rede Docker já existente do Nginx Proxy Manager (grupocatarina-vps).
# Detectada na implantação; normalmente grupocatarina-vps_default.
REDE_EXTERNA=grupocatarina-vps_default

# Banco de dados PostgreSQL (interno, não exposto)
POSTGRES_USER=sgo
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=orcamento

# Senha de acesso ao portal (formato hash, não a senha em texto).
# Gere com: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'SuaSenhaDoPortal'
SENHA_PORTAL_HASH=cole-aqui-o-hash-gerado

# Fase 6 em diante (backend)
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
